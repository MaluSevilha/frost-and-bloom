--- !u!114 &648055569
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 648055567}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5813b94f988678148b3c7d8945fc3fca, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  dialogueUI: {fileID: 1322312809}
  luminiPortrait: {fileID: 1263449661410444649, guid: 2991c9f716818184fa3de385d07ee33e, type: 3}
  controlFlags: {fileID: 2057354478}
  steps:
  - text: "Ei\u2026 voc\xEA acordou. Est\xE1 perdida?"
    stepType: 0
  - text: "Sou Lumini. Esta \xE9 Velmora\u2026 a floresta onde esp\xEDritos vagam
      entre a vida e o fim."
    stepType: 0
  - text: "Desde que Ortex rompeu as esta\xE7\xF5es, a floresta foi corrompida. Se
      ficar aqui por muito tempo\u2026 ser\xE1 consumida tamb\xE9m."
    stepType: 0
  - text: "Vamos. Use \u2190 e \u2192 para se mover."
    stepType: 1
  - text: "Boa! Agora pressione \u2191 para pular."
    stepType: 2
  - text: "Isso n\xE3o deveria ser poss\xEDvel\u2026Voc\xEA atravessa o rompimento
      das esta\xE7\xF5es sem desaparecer."
    stepType: 0
  - text: Pressione o floco de neve para alternar entre para a Frost
    stepType: 3
  - text: "Duas almas\u2026 dividindo o mesmo ciclo. Voc\xEA carrega Frost e Bloom
      dentro de si."
    stepType: 0
  - text: "A floresta muda com voc\xEA. Observe o ambiente\u2026 e encontre o caminho
      para sair."
    stepType: 0
